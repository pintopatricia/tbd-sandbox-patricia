{
  "name": "@ppb/tbd-store",
  "version": "1.429.0",
  "description": "",
  "main": "dist/index.js",
  "react-native": "index.ts",
  "module": "index.ts",
  "sideEffects": false,
  "scripts": {
    "test": "yarn node --expose-gc $(yarn bin jest) --maxWorkers=50%",
    "test:leaks": "yarn node --expose-gc $(yarn bin jest) --runInBand --logHeapUsage --detectLeaks",
    "test:coverage": "yarn test --coverage",
    "test:branch:coverage": "yarn node --expose-gc $(yarn bin jest) --changedSince origin/master --coverage --coverageThreshold='{\"global\":{\"branches\":\"0\",\"functions\":\"0\",\"lines\":\"0\"}}'",
    "test:watch": "yarn node --expose-gc $(yarn bin jest) -i --watch",
    "format": "prettier --ignore-path ../../.prettierignore --write \"./**/*.{js,ts,tsx}\"",
    "lint": "eslint ./ --quiet",
    "typecheck": "tsc -b && tsc -b tsconfig.test.json",
    "build": "tsc -b"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@flutter-global/uki-channels-http-clients": "7.1.0",
