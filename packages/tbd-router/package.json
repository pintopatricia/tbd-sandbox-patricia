{
  "name": "@ppb/tbd-router",
  "version": "0.0.1",
  "description": "Package to handle TBD router functions",
  "main": "index.ts",
  "scripts": {
    "build": "tsc -b",
    "format": "prettier --ignore-path ../../.prettierignore --write \"./**/*.{js,ts}\"",
    "lint": "eslint .",
    "test": "yarn node --expose-gc $(yarn bin jest) --maxWorkers=50%",
    "test:leaks": "yarn node --expose-gc $(yarn bin jest) --runInBand --logHeapUsage --detectLeaks",
    "test:coverage": "yarn node --expose-gc $(yarn bin jest)  --maxWorkers=50% --coverage",
    "test:branch:coverage": "yarn node --expose-gc $(yarn bin jest) --changedSince origin/master --coverage --coverageThreshold='{\"global\":{\"branches\":\"0\",\"functions\":\"0\",\"lines\":\"0\"}}'",
    "test:watch": "yarn node --expose-gc $(yarn bin jest) -i --watch",
    "typecheck": "tsc -b"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ppb/tbd-routes": "4.71.2",
    "@ppb/tbd-store": "workspace:*",
    "@ppb/tbd-urn-codecs": "9.81.2",
    "history": "4.10.1",
    "react": "19.0.0",
    "tagging-library": "4.5.1"
  },
  "peerDependencies": {
    "@adobe/react-native-aepcampaignclassic": "6.0.2",
    "@react-navigation/native": "7.1.20",
    "react-native": "0.78.3",
    "react-native-inappbrowser-reborn": "3.7.0",
    "react-native-notifications": "5.1.0",
    "urbanairship-react-native": "14.7.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/eslint-parser": "7.28.5",
    "@swc/core": "1.10.18",
    "@swc/jest": "0.2.37",
    "@types/node": "24.12.4",
    "eslint": "9.17.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jasmine": "4.1.3",
    "jest": "29.7.0",
    "prettier": "3.0.3",
    "ts-jest": "29.1.1",
    "typescript": "5.3.3",
    "typescript-eslint": "8.18.2"
  }
}
