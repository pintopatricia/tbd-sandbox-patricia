{
  "name": "@ppb/etx-edit-orchestrator",
  "description": "Betfair Exchange Transactional service edit operation orchestrator",
  "version": "0.9.1",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "format": "prettier --ignore-path ../../.prettierignore --write './**/*.{js,ts}'",
    "lint": "eslint ./ --quiet",
    "clean": "rm -rf dist coverage || true",
    "test": "yarn node --expose-gc $(yarn bin jest) --maxWorkers=50%",
    "test:leaks": "yarn node --expose-gc $(yarn bin jest) --runInBand --logHeapUsage --detectLeaks",
    "test:coverage": "yarn node --expose-gc $(yarn bin jest)  --maxWorkers=50% --coverage",
    "test:branch:coverage": "yarn node --expose-gc $(yarn bin jest) --changedSince origin/master --coverage --coverageThreshold='{\"global\":{\"branches\":\"0\",\"functions\":\"0\",\"lines\":\"0\"}}'",
    "test:watch": "yarn node --expose-gc $(yarn bin jest) -i --watch",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@flutter-global/uki-channels-http-clients": "7.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/eslint-parser": "7.28.5",
    "@ppb/eslint-plugin-tbd-rules": "0.5.0",
    "@types/jest": "29.5.13",
    "@types/node": "24.12.4",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "prettier": "3.0.3",
    "ts-jest": "29.1.1",
    "typescript": "5.3.3",
    "typescript-eslint": "8.18.2"
  }
}
