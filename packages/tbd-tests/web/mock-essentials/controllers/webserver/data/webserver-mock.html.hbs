  <script>
    const TICK_INTERVAL = 50;
    window.setIntervalOG = setInterval;
    window.clearIntervalOG = clearInterval;
    window.unpause = () => {
      if (window.tickIntervalId) {
        throw new Error("You didn't pause first!");
      }
      window.tickIntervalId = setIntervalOG(() => {
        window.fakeTimersClock.tick(TICK_INTERVAL)
      }, TICK_INTERVAL);
    }
    window.pause = () => {
      if (!window.tickIntervalId) {
        throw new Error("You didn't unpause first!");
      }
      window.clearIntervalOG(window.tickIntervalId);
      window.tickIntervalId = null;
    }

    window.fakeTimersClock = FakeTimers.withGlobal(window).install({
      toFake: ["Date", "setTimeout", "clearTimeout", "setInterval", "clearInterval", "performance"],
      /* https://bugs.chromium.org/p/chromedriver/issues/detail?id=2599#c26 */
      shouldAdvanceTime: false,
      now: new Date("{{date}}{{^date}}1985-02-05T10:00{{/date}}")
    });
    window.unpause();
    {{#if pause}}
      window.pause();
    {{/if}}
    {{#if timeZone}}
    const original = Intl.DateTimeFormat;
    Intl.DateTimeFormat = function (locale,options) {
      return original(locale, Object.assign({}, options, {timeZone: "{{timeZone}}"}))
    }
    {{/if}}
  </script>
