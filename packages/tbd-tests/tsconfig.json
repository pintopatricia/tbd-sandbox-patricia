{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /* Modules */
    "module": "commonjs",
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/jasmine-framework",
      "@types/jasmine",
      "expect-webdriverio/jasmine",
      "wdio-image-comparison-service/types"
    ],

    /* JavaScript Support */
    "allowJs": true,

    /* Language and Environment */
    "target": "ES2020"
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "**/fake-timers.js"]
}
