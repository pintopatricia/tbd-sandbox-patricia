{
  "name": "@ppb/tbd-shared",
  "version": "1.0.0",
  "description": "Shared business logic between web and native",
  "scripts": {
    "stylelint": "stylelint 'components/**/*.css'",
    "stylelint:fix": "yarn run stylelint --fix",
    "test:web": "yarn node --expose-gc $(yarn bin jest) --maxWorkers=50%",
    "test:web:leaks": "yarn node --expose-gc $(yarn bin jest) --runInBand --logHeapUsage --detectLeaks",
    "test:web:watch": "yarn node --expose-gc $(yarn bin jest) -i --watch",
    "test:web:coverage": "yarn test:web --coverage --collectCoverageFrom='**/!(*.native).{ts,tsx}'",
    "test:native": "RNTL_SKIP_AUTO_CLEANUP=true yarn node --expose-gc --no-compilation-cache $(yarn bin jest) --maxWorkers=50% --config=jest.native.config.js",
    "test:native:leaks": "yarn node --expose-gc $(yarn bin jest) --config=jest.native.config.js --runInBand --logHeapUsage --detectLeaks",
    "test:native:watch": "yarn node --expose-gc $(yarn bin jest) -i --watch --config=jest.native.config.js",
    "test:native:coverage": "yarn test:native --coverage --collectCoverageFrom='**/*.native.{ts,tsx}'",
    "test": "yarn test:web && yarn test:native",
    "test:leaks": "yarn test:web:leaks && yarn test:native:leaks",
    "test:coverage": "yarn test:web:coverage && yarn test:native:coverage",
    "lint": "yarn run stylelint && eslint ./ --quiet",
    "typecheck": "yarn typecheck:web && yarn typecheck:native",
    "typecheck:web": "tsc -b",
    "typecheck:native": "tsc -b tsconfig.native.json",
    "format": "prettier --ignore-path ../../.prettierignore --write \"./**/*.{js,ts,tsx,jsx,css}\"",
    "purgecss": "node ../../tools/purgecss.js components .web.css .web.tsx"
  },
