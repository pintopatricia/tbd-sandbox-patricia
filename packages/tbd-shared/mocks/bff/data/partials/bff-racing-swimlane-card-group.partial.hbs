"__typename":"RacingSwimlaneCardGroup",
"urn": "{{urn}}{{^urn}}ppb:tbd:card:group#racingSwimlane{{/urn}}",
{{#with full}}
    "fullItems":{
        {{> bff-items }}
    },
{{/with}}
    "partialItems":{
        "edges": [
          {{#with partials}}
            {{#each edges}}
                {
                {{#with node}}
                    "node": {
                        "__typename": "{{__typename}}{{^__typename}}RaceMarketCard{{/__typename}}",
                        "urn": "{{urn}}{{^urn}}ppb:tbd:card:raceMarket::29359895{{/urn}}"
                    }
                {{/with}}
                }{{#unless @last}},{{/unless}}
            {{/each}}
          {{/with}}
        ]
    },
"racingSwimlaneCardGroupTitle": {{#if cardGroupTitle}}"{{cardGroupTitle}}"{{else}}null{{/if}},
{{#if viewAll}}
    {{#with viewAll}}
    "viewAll" : {
    "icon": {{#if icon}}"{{icon}}"{{else}}null{{/if}},
    "label": "{{label}}{{^label}}Category Links Label{{/label}}",
        {{#with viewLink}}
            "viewLink": {
                "viewUrl": "{{viewUrl}}{{^viewUrl}}/casino/c/slots/gamingCategory:slots{{/viewUrl}}",
                "viewUrn": "{{viewUrn}}{{^viewUrn}}ppb:tbd:view:gamingCategory:slots{{/viewUrn}}"
            }
        {{/with}}
    }
    {{/with}}
{{else}}
    "viewAll": null
{{/if}}
