"__typename": "PopularBetBuilderCard",
"urn": "{{urn}}{{^urn}}ppb:tbd:card:popularbetbuilder:bo-1|1|0|0{{/urn}}",
"numberOfItemsToDisplay": {{numberOfItemsToDisplay}}{{^numberOfItemsToDisplay}}5{{/numberOfItemsToDisplay}},
"viewLink": {
    "viewUrn": "{{viewLink.viewUrn}}{{^viewLink.viewUrn}}mockerURN{{/viewLink.viewUrn}}",
    "viewUrl": "{{viewLink.viewUrl}}{{^viewLink.viewUrl}}mockerUrl{{/viewLink.viewUrl}}"
},
"fixture": {
  {{> bff-fixture fixture}}
},
"sportevent": {
  {{> bff-sportevent sportevent}}
},
{{#with popularbettingopportunity}}
  "popularbettingopportunity": {
    "__typename": "PopularBettingOpportunity",
    "count": {{count}}{{^count}}123{{/count}},
    "urn": "{{urn}}{{^urn}}ppb:bettingOpportunity:popular:bo-1|1|0|0{{/urn}}",
    "id": "{{id}}{{^id}}bo-1|1|0|0{{/id}}",
    "type": {{#if type}}"{{type}}"{{else}}null{{/if}},
  {{#if selections}}
      "selections": [
        {{#each selections}}
          {
            {{#with market}}
              "market": {
                {{> bff-market}}
              },
            {{/with}}
            {{#with runner}}
              "runner": {
                "runnerURN": "{{runnerURN}}{{^runnerURN}}ppb:sbkRunner:924.1/1{{/runnerURN}}",
                "selectionId": {{selectionId}}{{^selectionId}}1{{/selectionId}}
              }
            {{else}}
              "runner": {
                "runnerURN": "ppb:sbkRunner:924.1/1",
                "selectionId": 1
              }
            {{/with}}
          }{{#unless @last}},{{/unless}}
        {{/each}}
      ]
    {{/if}}
  }
{{/with}}
