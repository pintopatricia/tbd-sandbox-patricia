"__typename": "{{__typename}}{{^__typename}}MarketCard{{/__typename}}",
"template": "{{template}}{{^template}}DEFAULT{{/template}}",
"urn": "{{urn}}{{^urn}}ppb:tbd:card:market:29436223{{/urn}}",
"viewLinks": [
  {{#each viewLinks}}{
    {{> bff-view-link}}
  }{{#unless @last}},{{/unless}}{{/each}}
],
"cardTitle": {{#if cardTitle}}"{{cardTitle}}"{{else}}null{{/if}},
"isRunnerExpandable": {{#if isRunnerExpandable}}{{isRunnerExpandable}}{{else}}false{{/if}},
"runnerViewLinks":
  {{#if runnerViewLinks}}
    [
      {{#each runnerViewLinks}}{
        "viewUrn": "{{viewUrn}}{{^viewUrn}}mockerURN{{/viewUrn}}",
        "viewUrl": "{{viewUrl}}{{^viewUrl}}mockerUrl{{/viewUrl}}",
        "runnerUrn": "{{runnerUrn}}{{^runnerUrn}}"ppb:excRunner:1.171826696/27871644/0"{{/runnerUrn}}"
      }{{#unless @last}},{{/unless}}{{/each}}
      ],
  {{else}}
    [],
  {{/if}}
"marketsHierarchy": {
  {{> bff-hierarchy marketsHierarchy}}
},
"numberOfItemsToDisplay": {{numberOfItemsToDisplay}}{{^numberOfItemsToDisplay}}null{{/numberOfItemsToDisplay}},
"displayRunners": {
{{#with displayRunners}}
  {{> bff-display-runners}}
{{/with}}
},
"marketPromo":
  {{#if marketPromo}}
    {{#with marketPromo}}
      {
        "title": "{{title}}{{^title}}market promo title{{/title}}",
        "description": "{{description}}{{^description}}market promo description{{/description}}",
        "signposting": "{{signposting}}{{^signposting}}EXTRA_PLACES{{/signposting}}"
      },
    {{/with}}
  {{else}}
    null,
  {{/if}}
"blurbs":[
  {{#each blurbs}}{
    {{> bff-informative-blurb}}
  }{{#unless @last}},{{/unless}}{{/each}}
]
