{
  "data":{
    "cancelPromotion":{
      "responseCode": {{responseCode}}{{^responseCode}}0{{/responseCode}},
      "responseMessage": null,
      {{#if promotion}}
        {{#with promotion}}
            "promotion":
            { {{> bff-ims-promotion }} }
        {{/with}}
      {{else}}
          "promotion": null
      {{/if}}
    }
  }
}
