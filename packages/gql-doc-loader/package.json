{
  "name": "@ppb/gql-doc-loader",
  "version": "2.1.1",
  "description": "Loads a GraphQL Document from '.gql', '.gqls', '.graphql', '.graphqls' files",
  "main": "dist/core.js",
  "module": "src/core.ts",
  "bin": {
    "persist-graphql": "./bin/persist-graphql"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -b",
    "prepare": "yarn run build",
    "lint": "echo 'no lint task'",
    "format": "prettier --ignore-path ../../../../.prettierignore --write './src/**/*.ts'",
    "test:coverage": "echo 'no test:coverage task'",
    "test:branch:coverage": "echo 'no test:branch:coverage task'",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@apollo/client": "4.1.6",
    "@apollo/generate-persisted-query-manifest": "1.4.0",
    "@babel/traverse": "7.28.5",
    "@babel/types": "^7.28.5",
    "@graphql-tools/graphql-file-loader": "8.0.0",
    "@graphql-tools/load": "8.0.1",
    "@ppb/schema-loader-github": "1.1.0",
    "cosmiconfig": "9.0.0",
    "glob": "10.3.10",
    "graphql": "16.9.0",
    "loader-utils": "3.3.1",
    "resolve": "1.17.0",
    "schema-utils": "2.6.4",
    "synckit": "0.9.0",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "7.20.5",
    "@types/glob": "7.1.1",
    "@types/node": "24.12.4",
    "@types/resolve": "^1.20.6",
    "prettier": "3.0.3",
    "typescript": "5.3.3"
  }
}
