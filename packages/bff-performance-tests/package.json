{
  "name": "bff-performance-tests",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "lint": "eslint ./ --quiet",
    "test": "wdio conf/wdio.conf.js",
    "test:local": "node tools/run-local-files.js",
    "test:local:debug": "node --inspect-brk tools/run-local-files.js",
    "test:ci": "wdio conf/wdio-grid.conf.js",
    "test:ci:sbg": "wdio conf/wdio-grid-sbg.conf.js",
    "perf:report": "npx http-server ./performance-report",
    "test:report": "echo 'test:report is DEPRECATED'",
    "test:report:generate": "echo 'test:report:generate is DEPRECATED'",
    "mockreplay:curl": "node tools/mock-replay-tool.js --curl tools/replay-curl.sh",
    "mockreplay:har": "node tools/mock-replay-tool.js --har tools/replay-har.har",
    "mockreplay:postman": "node tools/mock-replay-tool.js --postman tools/replay-postman.json",
    "mockreplay:mockeddata": "node tools/mock-replay-tool.js --mockeddata tools/mocked-data.json",
    "upload-jenkins-data": "node tools/ci/upload-jenkins-data.js"
  },
  "devDependencies": {
    "@automock-loadtester/browser-requests-recorder": "0.0.5",
    "@automock-loadtester/orchestrator": "0.0.17",
    "@automock-loadtester/static-html-reporter": "0.0.7",
    "@babel/core": "7.28.5",
    "@babel/eslint-parser": "7.28.5",
    "@pedrorfernandes/mockserver-client": "5.15.0",
    "@ppb/tbd-tests-web": "workspace:*",
    "@ppb/tbd-wdio-custom-commands": "0.7.3",
    "@ppb/wdio-lazy-element": "workspace:*",
    "@wdio/cli": "8.33.0",
    "@wdio/devtools-service": "8.32.4",
    "@wdio/jasmine-framework": "8.33.0",
    "@wdio/local-runner": "8.33.0",
    "@wdio/shared-store-service": "8.33.0",
    "@wdio/spec-reporter": "8.32.4",
    "axios": "1.7.7",
    "curl-to-har": "1.0.1",
    "eslint": "9.17.0",
    "eslint-plugin-jasmine": "4.1.3",
    "eslint-plugin-wdio": "9.16.2",
    "postman-collection": "4.4.0",
    "typescript-eslint": "8.18.2",
    "webdriverio": "8.33.0",
    "yargs": "17.7.2"
  }
}
