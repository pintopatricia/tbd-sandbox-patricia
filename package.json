{
  "name": "tbd-mobile-site",
  "version": "1.0.0",
  "description": "such znice page",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/tbd-tests/web",
      "packages/tbd-tests/native",
      "apps/bf/*",
      "apps/sbg/*",
      "apps/ps/*",
      "apps/pp/*",
      "apps/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "Team 0",
  "license": "MIT",
  "config": {
    "node_version": "v24.14.0",
    "commitizen": {
      "path": "./node_modules/@chlo3w/cz-customizable"
    }
  },
  "scripts": {
    "postinstall": "husky || true",
    "prepare": "yarn workspaces foreach -tv run prepare",
    "commit": "git-cz",
    "check:nodeversion": "tools/compare_node_version.sh",
    "rpm": "tools/rpm_build.sh tbd-mobile-site && node tools/cimanifest.js tbd-mobile-site",
    "rpm:sbg": "tools/rpm_build.sh tbdsbg-mobile-site && node tools/cimanifest.js tbdsbg-mobile-site",
    "rpm:ps": "tools/rpm_build.sh tbdps-mobile-site && node tools/cimanifest.js tbdps-mobile-site",
    "rpm:pp": "tools/rpm_build.sh tbdpp-mobile-site && node tools/cimanifest.js tbdpp-mobile-site",
    "rpm:exc": "tools/rpm_build.sh tbdexc-mobile-site && node tools/cimanifest.js tbdexc-mobile-site",
    "mono:test": "yarn worktree:root:test",
    "mono:test:branch": "yarn worktree:root:test:branch",
    "mono:format": "yarn worktree:root:format",
    "mono:lint": "nx run-many --target=lint",
    "mono:typecheck": "nx run-many --target=typecheck",
    "worktree:root:test": "nx affected --target=test:coverage",
    "worktree:root:test:branch": "yarn workspaces foreach run test:branch:coverage && yarn generate:global:coverage",
    "worktree:root:format": "nx affected --target=format",
    "worktree:root:lint": "nx affected --target=lint",
    "worktree:root:typecheck": "nx affected --target=typecheck",
    "lint": "nx affected --target=lint",
    "test": "nx run-many --target=test --exclude=bff-performance-tests",
    "generate:global:coverage": "echo 'COVERAGE REPORT: ' && istanbul-combine -d coverage -p summary -r cobertura ./(packages|apps|native|web)/**/coverage-final.json || exit 0",
    "get-translations": "yarn workspaces foreach run get-translations && node tools/generate-translation-keys.js && node tools/validate-translations.js",
    "install-translations-tool": "pip install translations-tool==1.0.2 --trusted-host artifactory-prd.prd.betfair -i https://artifactory-prd.prd.betfair/artifactory/api/pypi/pypi/simple",
    "filter-translations": "node tools/filter-translations.js",
    "generate-apollo-types": "graphql-codegen --config packages/tbd-shared/codegen.ts && prettier --write packages/tbd-shared/types/__generated__/*",
    "generate-bff-response-types": "graphql-codegen --config packages/tbd-store/clients/catalogue/codegen.ts && prettier --write packages/tbd-store/clients/catalogue/catalogue-response-types.ts",
    "generate-extracted-queries:store": "bash tools/persist_graphql.sh -o store",
    "generate-extracted-queries:bff": "bash tools/persist_graphql.sh -o bff",
    "generate-extracted-queries:apollo": "bash tools/persist_graphql.sh -o apollo",
    "generate-bff-persisted-queries": "yarn run generate-extracted-queries:store && yarn run generate-extracted-queries:bff && yarn run generate-extracted-queries:apollo",
    "generate-sca-response-types": "graphql-codegen --config packages/tbd-store/clients/sca/codegen.yml && prettier --write packages/tbd-store/clients/sca/sports-content-api-response-types.ts",
    "generate-blh-response-types": "graphql-codegen --config packages/tbd-store/clients/blh/codegen.yml && prettier --write packages/tbd-store/clients/blh/bet-live-hypotheticals-response-types.ts",
    "compile-graphql": "yarn && yarn run generate-bff-response-types && yarn run generate-apollo-types && yarn run generate-bff-persisted-queries",
    "syncpack:list": "syncpack list-mismatches",
    "syncpack:fix": "syncpack fix-mismatches",
    "generate-config-files": "sh tools/generate-config-files.sh",
    "generate-env-files": "sh tools/generate-env-files.sh",
    "check:triggers": "sh tools/ci/main_orchestrator_dry_run.sh",
    "test:tools": "yarn node --expose-gc $(yarn bin jest) --maxWorkers=50% --config jest.tools.config.js",
    "tbd-component": "sh tools/tbd-component.sh"
  },
  "devDependencies": {
    "@apollo/generate-persisted-query-manifest": "1.4.0",
    "@apollo/persisted-query-lists": "1.1.0",
    "@babel/core": "7.28.5",
    "@babel/eslint-parser": "7.28.5",
    "@babel/preset-env": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@chlo3w/cz-customizable": "1.1.1",
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@graphql-codegen/add": "5.0.0",
    "@graphql-codegen/cli": "5.0.0",
    "@graphql-codegen/client-preset": "4.2.5",
    "@graphql-codegen/core": "4.0.0",
    "@graphql-codegen/typescript": "4.0.1",
    "@graphql-codegen/typescript-operations": "4.0.1",
    "@ppb/gql-doc-loader": "2.1.1",
    "@ppb/schema-loader-github": "1.1.0",
    "@ppb/vault-template-secrets-builder": "1.2.2",
    "@react-native/eslint-config": "0.78.3",
    "@types/jest": "29.5.13",
    "@types/node": "24.12.4",
    "ajv": "^8.18.0",
    "commitizen": "4.3.1",
    "eslint": "9.17.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-filenames": "1.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jasmine": "4.1.3",
    "eslint-plugin-jest": "29.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-unicorn": "46.0.1",
    "eslint-plugin-wdio": "9.16.2",
    "follow-redirects": "1.15.6",
    "glob": "10.3.10",
    "graphql": "16.9.0",
    "graphql-tag-pluck": "0.8.4",
    "husky": "9.1.5",
    "istanbul-combine": "0.3.0",
    "jest": "29.7.0",
    "json-ts": "1.6.4",
    "lint-staged": "14.0.1",
    "lodash": "^4.17.23",
    "npm-run-all": "4.1.5",
    "nx": "20.0.0",
    "path": "0.12.7",
    "prettier": "3.0.3",
    "resemblejs": "5.0.0",
    "syncpack": "12.3.0",
    "typescript": "5.3.3",
    "typescript-eslint": "8.18.2"
  },
  "resolutions": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "canvas": "3.1.1",
    "@monterosa-sdk/react-native": "0.2.7",
    "@monterosa/sdk-connect-kit": "0.18.6",
    "@monterosa/sdk-core": "0.18.6",
    "@monterosa/sdk-identify-kit": "0.18.6",
    "@monterosa/sdk-interact-kit": "0.18.6",
    "@monterosa/sdk-launcher-kit": "0.18.6"
  },
  "packageManager": "yarn@3.2.4",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0"
  }
}
