        "^packages/tbd-router/web/.*",
        "^apps/ps/web/.*",
        "^apps/ps/tbdps-mobile-site.spec",
        "^packages/tbd-tests/web/.*",
        "^Docker/tbd/.*",
        "^yarn.lock"
      ],
      "job_ignore_files": [
        "^packages/tbd-store/clients/catalogue/extracted_queries_v.*",
        "^packages/tbd-shared/.*native.*"
      ]
    }
  ],
  "tbdpp_ci_build": [
    {
      "job": [
        "tbdpp_ci_build"
      ],
      "regex": [
