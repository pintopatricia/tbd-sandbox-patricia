    },
    "speedIndex": {
      "name": "Speed Index",
      "collector": "@@calc.@@view.SpeedIndex",
      "storage": "perf.webpagetest.tbd.@@calc.@@view.speedIndex"
    },
    "firstInteractive": {
      "name": "Speed Index",
      "collector": "@@calc.@@view.FirstInteractive",
      "storage": "perf.webpagetest.tbd.@@calc.@@view.firstInteractive"
