{
  "METRICS_TAGS": [
    { "view": "firstView", "calc": "median" },
    { "view": "repeatView", "calc": "median" }
  ],
  "METRICS_MAPPING": {
    "loadTime": {
      "name": "Load Time",
      "collector": "@@calc.@@view.loadTime",
      "storage": "perf.webpagetest.tbd.@@calc.@@view.loadTime"
    },
    "ttfb": {
      "name": "Time To First Byte",
      "collector": "@@calc.@@view.TTFB",
      "storage": "perf.webpagetest.tbd.@@calc.@@view.ttfb"
    },
    "firstPaint": {
      "name": "First Paint",
      "collector": "@@calc.@@view.firstPaint",
      "storage": "perf.webpagetest.tbd.@@calc.@@view.firstPaint"
    },
    "firstContentfulPaint": {
      "name": "First Contentful Paint",
      "collector": "@@calc.@@view.firstContentfulPaint",
      "storage": "perf.webpagetest.tbd.@@calc.@@view.firstContentfulPaint"
    },
    "largestContentfulPaint": {
      "name": "Largest Contentful Paint",
      "collector": "@@calc.@@view['chromeUserTiming.LargestContentfulPaint']",
      "storage": "perf.webpagetest.tbd.@@calc.@@view.largestContentfulPaint",
      "spamStorage": "spam.tbd.web-mobile.vital.lcp.p75"
    },
    "cumulativeLayoutShift": {
      "name": "Cumulative Layout Shift",
