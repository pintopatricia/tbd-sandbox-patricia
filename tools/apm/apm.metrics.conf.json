    },
    "firstMeaningfulPaint": {
      "name": "First Meaningful Paint",
      "collector": "@@calc.@@view.firstMeaningfulPaint",
      "storage": "perf.webpagetest.tbd.@@calc.@@view.firstMeaningfulPaint"
    },
    "fullyLoaded": {
      "name": "Fully Loaded",
      "collector": "@@calc.@@view.fullyLoaded",
      "storage": "perf.webpagetest.tbd.@@calc.@@view.fullyLoaded"
    },
    "timeToInteractive": {
