{
  "name": "@ppb/tbdbf-webapp",
  "version": "3.324.2",
  "private": true,
  "description": "BF Rebuild web app",
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "Team 0",
  "license": "MIT",
  "scripts": {
    "build": "make build BRAND=bf ENVIRONMENT=qa",
    "build:dev": "make build-dev BRAND=bf ENVIRONMENT=dev",
    "build:nxt": "make build-nxt BRAND=bf ENVIRONMENT=nxt",
    "build:qacms": "make build-qacms BRAND=bf ENVIRONMENT=qacms",
    "build:webserver": "mkdir -p ./dist && rspack --config rspack/rspack.prod.js",
    "build:local": "yarn build:webserver --json ./dist/stats.json",
    "build:local:doctor": "mkdir -p ./dist && RSDOCTOR=true rspack --config rspack/rspack.prod.js --json ./dist/stats.json",
    "get-translations-brand": "translations-tool --file config/${BRAND}/lokalise_config.json && prettier --write config/${BRAND}/translations/generated/*",
    "get-translations": "translations-tool --file lokalise_config.json && prettier --write ./generated/translations/* && BRAND=bf yarn get-translations-brand",
    "start": "yarn start:qa",
    "start:webserver": "rspack serve --config rspack/rspack.dev.js",
    "start:dev": "make start-dev BRAND=bf ENVIRONMENT=dev",
    "start:qa": "make start-qa BRAND=bf ENVIRONMENT=qa",
    "start:nxt": "make start-nxt BRAND=bf ENVIRONMENT=nxt",
    "start:dev-nxt": "make start-dev-nxt BRAND=bf ENVIRONMENT=nxt",
    "start:qacms": "make start-qacms BRAND=bf ENVIRONMENT=qacms",
    "stop": "make stop",
    "local-selenium-grid:help": "local-selenium-grid --help",
    "local-selenium-grid:start": "local-selenium-grid --start",
    "local-selenium-grid:start-debug": "local-selenium-grid --start-debug",
    "local-selenium-grid:stop": "local-selenium-grid --stop",
    "local-selenium-grid:scale": "local-selenium-grid --scale $1 $2",
    "test": "yarn node --expose-gc $(yarn bin jest) --maxWorkers=50%",
    "test:leaks": "yarn node --expose-gc $(yarn bin jest) --runInBand --logHeapUsage --detectLeaks",
    "test:watch": "yarn node --expose-gc $(yarn bin jest) -i --watch",
    "test:coverage": "yarn node --expose-gc $(yarn bin jest)  --maxWorkers=50% --coverage",
    "test:branch:coverage": "mkdir -p ./reports/web && yarn node --expose-gc $(yarn bin jest) --changedSince origin/master --coverage --coverageDirectory ./reports/web/ --coverageThreshold='{\"global\":{\"branches\":\"0\",\"functions\":\"0\",\"lines\":\"0\"}}'",
    "start-vnc": "open vnc://0.0.0.0:5900",
    "lint": "eslint ./ --quiet",
    "typecheck": "tsc -b",
    "format": "prettier --ignore-path ../../../.prettierignore --write ./**/*.{js,ts,tsx,jsx,css}",
    "bundle:fake-timers": "browserify -s FakeTimers -o regression-tests/helpers/fake-timers/fake-timers.js regression-tests/helpers/fake-timers/fake-timers-src.js",
    "size": "bundlesize",
    "perf": "node ../../../tools/bundle-size.js"
  },
  "dependencies": {
    "@apollo/client": "4.1.6",
    "@ppb/betslip-core": "8.16.1",
    "@ppb/chart-tools": "2.60.2",
    "@ppb/formatters": "1.2.0",
    "@ppb/tbd-router": "workspace:*",
