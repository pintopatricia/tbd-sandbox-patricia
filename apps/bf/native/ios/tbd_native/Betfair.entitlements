<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.betfair.com</string>
		<string>applinks:promotions.betfair.com</string>
		<string>applinks:promos.betfair.com</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.betfair.multiples.BetfairSportsbookNotificationExtension</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.betfair.CetModuleExample</string>
		<string>$(AppIdentifierPrefix)com.betfair.sso</string>
	</array>
</dict>
</plist>
