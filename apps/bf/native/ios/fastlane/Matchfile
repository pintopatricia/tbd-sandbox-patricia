# The bundle identifier(s) of your app (comma-separated)
app_identifier([
  "com.betfair.tbd.qa",
  "com.betfair.tbd.in-house",
  "com.betfair.tbd.qa.NotificationServiceExtension",
  "com.betfair.tbd.in-house.NotificationServiceExtension",
