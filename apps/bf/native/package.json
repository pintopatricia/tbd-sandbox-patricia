{
  "name": "@ppb/tbd-native",
  "version": "0.288.0-alpha.0",
  "private": true,
  "scripts": {
    "docker:build": "make build",
    "docker:start": "make start",
    "docker:start:nxt": "make start-nxt",
    "docker:stop": "make stop",
    "environment": "../../../tools/scripts/native/appconfig/setEnvironment.js",
    "releaseMode": "../../../tools/scripts/native/appconfig/setReleaseMode.js",
    "loadingDomain": "../../../tools/scripts/native/appconfig/setLoadingDomain.js",
    "loadingSubdomain": "../../../tools/scripts/native/appconfig/setLoadingSubdomain.js",
    "deviceProperties": "../../../tools/scripts/native/appconfig/setDeviceProperties.js",
    "cookies": "../../../tools/scripts/native/appconfig/setCookies.js",
    "customEnv": "../../../tools/scripts/native/appconfig/setCustomEnvironment.js",
    "android": "sh ./scripts/run-android.sh",
    "android:clear": "sh ./scripts/clear.sh android",
    "android:release:play": "ENV=prd MODE=production VARIANT=playRelease SUFFIX=release yarn android",
    "android:inhouse:play": "ENV=qa MODE=internal VARIANT=playInhouse SUFFIX=inhouse yarn android",
    "android:debug:play": "ENV=localhost MODE=internal VARIANT=playDebug SUFFIX=qa yarn android",
    "android:debug": "ENV=localhost MODE=internal VARIANT=playDebug SUFFIX=qa yarn android",
    "android:internal": "ENV=prd MODE=internal VARIANT=playInhouse SUFFIX=inhouse yarn android",
    "android:production": "ENV=prd MODE=production VARIANT=playRelease SUFFIX=release yarn android",
    "android:build:ci": "cd ../../.. && docker build --build-arg NATIVE_BUILD_NUMBER=${BUILD_NUMBER} --build-arg GITHUB_TOKEN=${GITHUB_TOKEN} --build-arg MONTEROSA_TOKEN=${MONTEROSA_TOKEN} -t ppb/tbdn/build-inhouse -f ./apps/bf/native/Docker/targets/inhouse/build-inhouse.Dockerfile .",
    "android:qa": "ENV=qa MODE=internal VARIANT=playDebug SUFFIX=qa yarn android",
    "android:qa:build:ci": "cd ../../.. && docker build --build-arg NATIVE_BUILD_NUMBER=${BUILD_NUMBER} --build-arg GITHUB_TOKEN=${GITHUB_TOKEN} --build-arg MONTEROSA_TOKEN=${MONTEROSA_TOKEN} -t ppb/tbdn/build-qa -f ./apps/bf/native/Docker/targets/qa/build-qa.Dockerfile .",
    "android:qa:deploy:ci": "yarn get-release-notes && docker build --build-arg FIREBASE_CI_KEY=${FIREBASE_CI_KEY} --build-arg GITHUB_TOKEN=${GITHUB_TOKEN} --build-arg MONTEROSA_TOKEN=${MONTEROSA_TOKEN} -t ppb/tbdn/deploy-qa -f ./Docker/targets/qa/deploy-qa.Dockerfile .",
    "android:qa:it": "ENV=qaIT MODE=internal VARIANT=playDebug SUFFIX=qa yarn android",
    "android:mockserver": "ENV=mockserver MODE=internal VARIANT=playDebug SUFFIX=qa yarn android",
    "android:nxt": "ENV=nxt MODE=internal VARIANT=playDebug SUFFIX=qa yarn android",
    "multi:android:betfair:debug": "ENV=qa MODE=internal VARIANT=betfairDebug SUFFIX=qa yarn android",
    "multi:android:betfair:brazil": "ENV=prd MODE=production VARIANT=betfairBrazilRelease SUFFIX=release yarn android",
    "multi:android:betfair:inhouse": "ENV=qa MODE=internal VARIANT=betfairInHouse SUFFIX=inhouse yarn android",
    "multi:android:betfair:release": "ENV=prd MODE=production VARIANT=betfairRelease SUFFIX=release yarn android",
    "ios": "sh ./scripts/run-ios.sh",
    "ios:clear": "sh ./scripts/clear.sh ios",
    "ios:mockserver": "ENV=mockserver MODE=internal VARIANT=Debug yarn ios",
    "ios:localhost": "ENV=localhost MODE=internal VARIANT=Debug yarn ios",
    "ios:qa": "ENV=qa MODE=internal VARIANT=Debug yarn ios",
    "ios:qa:es": "ENV=qaES MODE=internal VARIANT=Debug yarn ios",
    "ios:qa:it": "ENV=qaIT MODE=internal VARIANT=Debug yarn ios",
    "ios:nxt": "ENV=nxt MODE=internal VARIANT=Debug yarn ios",
    "ios:nxt:es": "ENV=nxtES MODE=internal VARIANT=Debug yarn ios",
    "ios:nxt:it": "ENV=nxtIT MODE=internal VARIANT=Debug yarn ios",
    "ios:prf": "ENV=prf MODE=internal VARIANT=Debug yarn ios",
    "ios:prd": "ENV=prd MODE=internal VARIANT=Debug yarn ios",
    "ios:internal": "ENV=qa MODE=internal VARIANT=Debug yarn ios",
    "ios:production": "ENV=prd MODE=production VARIANT=Release yarn ios",
    "ios:inhouse": "ENV=qa MODE=internal VARIANT=In_House yarn ios",
    "get-translations": "yarn get-translations:native && yarn get-translations:native:ios && yarn get-translations:native:android",
    "get-translations:native": "translations-tool --file lokalise_config.json && prettier --write ./generated/translations/*",
    "get-translations:native:ios": "translations-tool --file lokalise_config_ios.json",
    "get-translations:native:android": "translations-tool --file lokalise_config_android.json",
    "start": "EXPO_NO_METRO_WORKSPACE_ROOT=1 react-native start",
    "start:clean": "EXPO_NO_METRO_WORKSPACE_ROOT=1 watchman watch-del-all && react-native start --reset-cache",
    "test": "RNTL_SKIP_AUTO_CLEANUP=true yarn node --expose-gc --no-compilation-cache $(yarn bin jest) -c --maxWorkers=50%",
    "test:leaks": "yarn node --expose-gc $(yarn bin jest) --runInBand --logHeapUsage --detectLeaks",
    "test:watch": "yarn test --verbose --watch",
    "test:coverage": "yarn test --coverage --collectCoverageFrom='**/*.{ts,tsx}'",
    "test:branch:coverage": "mkdir -p ./reports/native && yarn test:coverage --changedSince origin/master --coverageDirectory ./reports/native/ --coverageThreshold='{\"global\":{\"branches\":\"0\",\"functions\":\"0\",\"lines\":\"0\"}}'",
    "generate:report": "yarn test:coverage --verbose && open ./coverage/lcov-report/index.html",
    "lint": "eslint ./ --quiet",
    "format": "prettier --ignore-path ../.prettierignore --write ./**/*.{js,ts,tsx}",
    "typecheck": "tsc -b",
    "configureFirebase": "sh ./scripts/firebase/configureFirebase.sh",
    "check-deps-versions": "sh ./scripts/versioning/check-deps-versions.sh",
    "get-release-notes": "sh ./scripts/get-release-notes.sh"
  },
