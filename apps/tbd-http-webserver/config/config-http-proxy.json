{
  "env": "development",
  "strand": {
    "module": "/fabric/deploy/tbd-http-webserver/dist/tbd-http-webserver-v1"
  },
  "stereotype": {
    "http": {
      "ifc": "0.0.0.0",
      "port": 8081,
      "scriptContext": "/api",
      "circuitBreakerThreshold": 70,
      "maxTimeout": 5000,
      "socketKeepAliveTimeOut": 120e3,
      "stopTimeOut": 2000,
      "cors": {
        "allowedOrigins": "*",
        "allowedMethods": "GET,POST,HEAD",
        "allowedHeaders": "X-Requested-With,Content-Type,Accept,Origin",
        "preflightMaxAge": 1800,
        "allowCredentials": true,
        "exposedHeaders": ""
      },
      "validateXApplicationHeader": false
    }
  },
  "plugins": {
    "metrics": {},
    "IAP-REGISTRY": {
      "url": "http://artifactory-prd.prd.betfair/artifactory/",
      "auth": "fakeUser:fakePassword",
      "poolSize": 20,
      "timeout": 2000
    },
    "ERO-UK": {
      "url": "http://uk-api.nxt.dev.betfair/api/ero-json-rpc",
      "poolSize": 20,
      "timeout": 2000
    },
    "Facet": {
      "url": "http://uk-api.app.betfair/api/nav-json-rpc",
      "poolSize": 20,
      "timeout": 2000
    },
    "FacetSportsbook": {
      "url": "http://nav-sb.app.betfair/api/nav-json-rpc",
      "poolSize": 20,
      "timeout": 2000
    },
    "FacetSportsbookItaly": {
      "url": "http://itsbmga.app.betfair/api/nav-json-rpc",
      "poolSize": 20,
      "timeout": 2000
    },
    "SportsNav": {
      "url": "http://nav.nxt.dev.betfair/api/nav-json-rpc",
      "poolSize": 20,
      "timeout": 2000
    },
    "SSM": {
      "url": "http://ssmbf.prd.internal/SessionManagement/v1.0/",
      "poolSize": 20,
      "timeout": 1000,
      "keepAliveTimeoutMs": 120e3
    },
    "SMR": {
      "url": "http://smr.nxt.internal/api/sports/fixedodds/readonly/v1.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "SMP": {
      "url": "http://smp.prd.internal/api/sports/fixedodds/readonly/v1.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "FixedOddsBetReporting": {
      "url": "http://fbr.prd.internal/api/FixedOddsBetReporting/v1.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "HeritageOXIFeed": {
      "url": "https://transactions.test-app-guea.staging.skybet.net/heritage-oxi-feed/v1/",
      "poolSize": 20,
      "timeout": 2000
    },
    "FixedOddsCashoutQuote": {
      "url": "http://fcq.prd.internal/api/json-rpc",
      "poolSize": 20,
      "timeout": 2000
    },
    "SEAS": {
      "url": "http://inplayservice.nxt.dev.betfair/inplayservice/v1.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "CAPI": {
      "url": "http://cat.nxt.dev.betfair/json-rpc",
      "poolSize": 20,
      "timeout": 2000
    },
    "GamesFeedService": {
      "url": "http://gfsbf.nxt.internal/GamesFeeds/v1.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "CasinoDataFeeds": {
      "url": "http://gfsbf.nxt.internal/CasinoDataFeeds/v1.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "CashoutReadOnly": {
      "url": "http://cos.prd.internal/cashout-service/readonly/v1.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "LiveBetReporting": {
      "url": "http://lbr.prd.internal/api/lbr-json-rpc",
      "poolSize": 20,
      "timeout": 2000
    },
    "SharedSiteComponents": {
      "url": "http://ssc.nxt.dev.betfair/api/v1/",
      "poolSize": 20,
      "timeout": 2000
    },
    "CustomerReadOnly": {
      "url": "http://crobf.prd.internal/CustomerReadOnly/v1.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "ESX": {
      "url": "http://esxbf.prd.internal/Exclusion/v1",
      "poolSize": 20,
      "timeout": 2000
    },
    "CustomRestClients": {
      "tbdCatalogue": {
        "keepAliveTimeoutMs": 120e3,
        "url": "http://reverseproxy/betting/api/tbd/bff-gql/v11",
        "poolSize": 20,
        "timeout": 2000,
        "headerStrategy": "basic"
      }
    },
    "FormsAndResults": {
      "url": "http://formsandresultsapiv2.app.betfair/rest/v2.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "ContentServingV2": {
      "url": "http://calbf.nxt.internal/ContentServing/v2/",
      "poolSize": 20,
      "timeout": 2000
    },
    "BrowserIdentity": {
      "url": "http://bxi.drk.internal/BoxeverIdentity/v1/",
      "poolSize": 20,
      "timeout": 5000
    },
    "Boxever": {
      "poolSize": 20,
      "timeout": 2000,
      "headerStrategy": "minimal",
      "url": "https://api.boxever.com/",
      "clientKey": "boxeverClientKey"
    },
    "BoxeverService": {
      "channel": "MOBILE_WEB",
      "pointOfSale": "betfair",
      "browserIdentityConfig": {
        "brand": "Betfair",
        "product": "Exchange",
        "channel": "Mobile"
      }
    },
    "UserSharedPreferences": {
      "url": "http://uspbf.prd.internal/usp-preferences/v1.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "AuthorisationService": {
      "url": "http://authorization-service.nxt.dev.betfair/Authorization/v1.0/",
      "poolSize": 20,
      "timeout": 2000,
      "headerStrategy": "admin"
    },
    "IdentitySso": {
      "url": "http://identitysso-service.nxt.dev.betfair/Identitysso/v1.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "MarketManagementX": {
      "url": "http://mmx-eu.nxt.dev.betfair/mmx/v1/",
      "poolSize": 20,
      "timeout": 2000
    },
    "CurrencyExchangeService": {
      "url": "http://cxs.prd.internal/CurrencyExchange/v1.0/",
      "poolSize": 20,
      "timeout": 2000
    },
    "SogeiMarketData": {
      "url": "http://psqf-v3.nxt.dev.betfair/SogeiMarketData/v1/",
      "poolSize": 20,
      "timeout": 2000
    },
    "UserService": {
      "localeRules": {
        "INTERNATIONAL": {
          "supportedLocales": ["en_GB", "en", "da", "de", "es_419", "pt_BR", "ru", "no", "fi", "hu"],
          "defaultLocale": "en_GB"
        }
      },
      "authTokenResolver": "cro",
      "cro": {
        "defaultCountryCode": "GB",
        "defaultDiscount": 0
      }
    },
    "ThrottlesService": {
      "store": "ssw-config",
      "path": "throttles/"
    },
    "ExchangeSettings": {
      "url": "http://ero.nxt.internal/api/ExchangeSettings/v1.0/",
      "poolSize": 20,
      "timeout": 5000
    },
    "fileSystem": {
      "rootPath": "/var/tmp"
    },
    "ExperimentationsService": {
      "urn": "prismic:flutter-experimentation-dev:en-gb:uid:experiment:null"
    },
    "LoopExperimentServiceV2": {
      "keepAliveTimeoutMs": 120000,
      "url": "https://les-nxtbf.platformservices-dev.aws.private/v2/",
      "poolSize": 20,
      "timeout": 2000,
      "headerStrategy": "minimal"
    },
    "CustomGraphqlClients": {
      "cds": {
        "url": "https://hasura.dev.dt.ppb/v1/graphql",
        "poolSize": 20,
        "timeout": 2000,
        "headerStrategy": "minimal"
      }
    },
    "log": {
      "rootFolder": "./log",
      "mask": "0755",
      "appenders": {
        "console": {
          "type": "console",
          "layout": {
            "type": "pattern",
            "pattern": "%[[%d] [%p] [pid=%x{pid}] [category=%c]%] %m"
          }
        }
      },
      "categories": {
        "default": {
          "appenders": ["console"],
          "level": "debug"
        }
      }
    }
  }
}
