ARG WEBSERVER_IMAGE=ppb/tbdbf/web/prod/webserver

FROM ${WEBSERVER_IMAGE} AS webserver

FROM docker.app.betfair/tbd-ci/bookworm-slim-fabric-base-image:master

ARG GITHUB_TOKEN
ARG MONTEROSA_TOKEN
ARG BRAND
ARG ENVIRONMENT
ENV GITHUB_TOKEN=$GITHUB_TOKEN
ENV MONTEROSA_TOKEN=$MONTEROSA_TOKEN

USER root
RUN mkdir -p /var/app/tbd/apps/tbd-http-webserver
RUN chown -R node:node /var/app/tbd

# set user as node (avoid using root) and set global npm configs
USER node
ENV VCPKG_FORCE_SYSTEM_BINARIES=1
ENV NPM_CONFIG_PREFIX=/home/node/.npm-global
ENV PATH=$PATH:/home/node/.npm-global/bin
ENV NODE_OPTIONS=--max_old_space_size=3072

# working over the monorepo outside the fabric deploy path, mimicking app deploy paths
WORKDIR /var/app/tbd

# install node deps
COPY --chown=node:node .yarn ./.yarn
COPY --chown=node:node package.json yarn.lock .yarnrc.yml .yarnrc.yml ./
COPY --chown=node:node apps/tbd-http-webserver/package.json ./apps/tbd-http-webserver/
COPY --chown=node:node apps/tbd-http-webserver/.yalc ./apps/tbd-http-webserver/.yalc
COPY --chown=node:node packages/tbd-store/package.json packages/tbd-store/

RUN yarn workspaces focus \
  @ppb/tbd-http-webserver \
  @ppb/tbd-store

# when running only this strand, replaces manifest usually generated by webpack
COPY ./apps/tbd-http-webserver/metadata/fake-manifest.json /var/tmp/webserver/tbd-assets/manifest.json

# copy source files and build strand
COPY --chown=node:node packages/tbd-store/ packages/tbd-store/

COPY apps/tbd-http-webserver/config/certificates ${FABRIC_CONFIG_PATH}/certificates
# this should not be here, but is a temporary "fix" to flex envs - will revisit soon to fix in a proper way
COPY apps/tbd-http-webserver/config/webserver-config-http-${BRAND}-${ENVIRONMENT}-flexenv.json ${FABRIC_CONFIG_PATH}/webserver-config-http.json

COPY apps/tbd-http-webserver/build.sh apps/tbd-http-webserver/
COPY apps/tbd-http-webserver/tsconfig.json apps/tbd-http-webserver/
COPY apps/tbd-http-webserver/lib/ apps/tbd-http-webserver/lib/

# These ENV files are parameterized for use with BF or SBG env files
COPY apps/tbd-http-webserver/lib/config/env-templates/environment-${BRAND}.${ENVIRONMENT}.json apps/tbd-http-webserver/lib/config/environment.json
COPY apps/tbd-http-webserver/lib/config/env-templates/environment-${BRAND}-backend.json apps/tbd-http-webserver/lib/config/environment-backend.json

WORKDIR /var/app/tbd/apps/tbd-http-webserver/

RUN yarn build

# Symlinks the strand content to fabric path leaving out all repo packages "behind".
# The strand paths become less verbose by removing the repo "apps/tbd-http-webserver" internal path for all
# configurations an compose files.
RUN ln -s /var/app/tbd/apps/tbd-http-webserver ${FABRIC_STRANDS_PATH}

WORKDIR ${FABRIC_PATH}

COPY --from=webserver /usr/share/nginx/html /var/tmp/webserver/tbd-assets

# The port the application listens to
EXPOSE 8081

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "--", "bin/fabric.js", "run", "/etc/bf-fabric/webserver-config-http.json"]
