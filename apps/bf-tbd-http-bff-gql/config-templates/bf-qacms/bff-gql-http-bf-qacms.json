  "stereotype": {
    "http": {
      "ifc": "0.0.0.0",
      "port": 8082,
      "scriptContext": "/api",
      "circuitBreakerThreshold": 300,
      "maxTimeout": 5000,
      "socketKeepAliveTimeOut": 120000,
      "stopTimeOut": 2000,
      "jsonBodyLimit": "200000",
      "cors": {
        "allowedOrigins": "*",
        "allowedMethods": "GET,POST,HEAD",
        "allowedHeaders": "X-Requested-With,Content-Type,Accept,Origin",
        "preflightMaxAge": 1800,
        "allowCredentials": true,
        "exposedHeaders": ""
      },
      "validateXApplicationHeader": true,
      "internalDomainSuffixes": ["sportschannels-dev.aws.private"]
    }
  },
