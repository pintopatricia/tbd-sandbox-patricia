<resources>

  <!-- Base application theme. -->
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <!-- Customize your theme here. -->
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="android:statusBarColor">@color/background</item>
    <item name="android:windowBackground">@color/background</item>
    <item name="android:alertDialogTheme">@style/AlertDialogTheme</item>
    <item name="android:navigationBarColor">@color/navigation_bg</item>
    <item name="android:windowLightNavigationBar">true</item>
  </style>

  <!-- Adds the splash screen definition -->
  <style name="SplashTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="windowSplashScreenBackground">@color/splashscreen_bg</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen_icon</item>
    <item name="windowSplashScreenAnimationDuration">60000</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
  </style>

  <!-- Adds alert dialog style -->
  <style name="DialogButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
    <item name="android:textColor">@color/alert_button</item>
  </style>

  <style name="DialogTitleStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
    <item name="android:textSize">20sp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:clickable">false</item>
  </style>

  <style name="AlertDialogTheme" parent="Base.Theme.AppCompat.Light.Dialog.Alert">
    <item name="android:background">@color/alert_background</item>
    <item name="android:textColor">@color/alert_title</item>
    <item name="android:textColorPrimary">@color/alert_message</item>
    <item name="android:windowTitleStyle">@style/DialogTitleStyle</item>
    <item name="android:buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
    <item name="android:buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
    <item name="dialogCornerRadius">8dp</item>
  </style>

</resources>
