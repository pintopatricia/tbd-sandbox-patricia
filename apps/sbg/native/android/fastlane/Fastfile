require_relative "lib/helpers"

default_platform(:android)

platform :android do
  before_all do |lane|
    if lane != :inhouseDeployFirebase && lane != :inhouseDebugDeployFirebase && lane!=:buildAndDeployArtifactoryApp && lane!=:buildReleaseBundle && lane !=:deployStoreApp && lane !=:deployFirebaseApp && lane !=:deployAWS
      gradle(task: "clean")
    end
  end

  after_each do |lane|
    if lane != :inhouseDeployFirebase && lane != :inhouseDebugDeployFirebase && lane!=:buildAndDeployArtifactoryApp && lane!=:buildReleaseBundle && lane !=:deployStoreApp && lane !=:deployFirebaseApp && lane !=:deployAWS
      reset_git_repo(
        force: true,
        files: [
          "../android/**/res/**/ic_launcher.png",
          "../android/**/res/**/ic_launcher_round.png"
        ]
      )
    end
  end

  # # TODO on Jira Ticket WISHTHK-213
