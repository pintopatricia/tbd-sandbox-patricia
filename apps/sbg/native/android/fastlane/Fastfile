  #     path: 'android/',
  #     upload_metadata: false
  #   )
  # end

  desc "Upload our In-House app to Firebase on CI for the stakeholders"
  lane :inhouseDeployFirebase do
    firebase_app_distribution(
      app: "1:471098256672:android:ec70c902bfe065a0b83b45",
      apk_path: "app/build/outputs/apk/play/inhouse/SkyBet-" + ENV['BUILD_NUMBER'] + ".apk",
      groups: 'sbgtbd-teams',
      release_notes: "App target: Play \n" + get_release_notes_from_file(),
      firebase_cli_token: ENV['FIREBASE_CI_KEY'],
      debug: true
    )
  end

  desc "Upload our QA apps to Firebase on CI for the stakeholders"
  lane :inhouseDebugDeployFirebase do
    firebase_app_distribution(
      app: "1:471098256672:android:7008f8c44aeda18cb83b45",
      apk_path: "app/build/outputs/apk/play/debug/app-play-debug.apk",
      groups: 'sbgtbd-teams',
      release_notes: "App target: Play \n" + get_release_notes_from_file(),
      firebase_cli_token: ENV['FIREBASE_CI_KEY'],
      debug: true
    )
  end
end
