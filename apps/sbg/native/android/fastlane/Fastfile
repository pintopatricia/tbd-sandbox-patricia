  #   gradle(task: "assemblePlayRelease")
  # end

  desc "Builds the store app (aab)"
  lane :buildReleaseBundle do |options|
    # changes push notifications environment to production
    # keys / secrets can be found on company https://www.airship.com/ account
    set_properties_value(
      path: "./app/src/main/assets/airshipconfig.properties",
      key: "inProduction",
      value: true
    )
    set_properties_value(
      path: "./app/src/main/assets/airshipconfig.properties",
      key: "productionAppKey",
      value: "JAzbLoGdRVSK5rgvXn4sgw"
    )
    set_properties_value(
      path: "./app/src/main/assets/airshipconfig.properties",
      key: "productionAppSecret",
      value: "AcTn45eiRySedJ4akefKJw"
    )

    gradle(task: "bundlePlayRelease")
  end

  # desc "Deploys to firebase (apk)"
  # lane :deployFirebaseApp do
  #   firebase_app_distribution(
  #     app: "1:237660054779:android:264b95c0f4fd4857547c5e",
  #     android_artifact_type: "APK",
  #     android_artifact_path: "android_release-"  + ENV['RELEASE_BUILD_NUMBER'] + ".apk",
  #     groups: 'bfrb-teams',
