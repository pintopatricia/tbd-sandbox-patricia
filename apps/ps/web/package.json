{
  "name": "@ppb/tbdps-webapp",
  "version": "3.324.2",
  "private": true,
  "description": "PokerStars Sports web app",
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "Team 0",
  "license": "MIT",
  "scripts": {
    "build:dev": "make build-dev",
    "build": "make build",
    "build:prod": "COMPOSE_DOCKER_CLI_BUILD=1 docker-compose -f Docker/prod_mode/docker-compose.yml build webserver && COMPOSE_DOCKER_CLI_BUILD=1 docker-compose -f Docker/prod_mode/docker-compose.yml build",
    "build:local": "mkdir -p ./dist && rspack --config rspack/rspack.prod.js --json ./dist/stats.json",
    "build:local:doctor": "mkdir -p ./dist && RSDOCTOR=true rspack --config rspack/rspack.prod.js --json ./dist/stats.json",
    "get-translations": "translations-tool --file lokalise_config.json && prettier --write ./generated/translations/*",
    "start": "yarn start:qa",
    "start:webserver": "rspack serve --config rspack/rspack.dev.js",
    "start:dev": "make start-dev",
    "start:dev:nxt": "make start-dev-nxt",
    "start:qa": "make start-qa",
    "start:qacms": "make start-qacms",
    "start:nxt": "make start-nxt",
    "start:prod": "docker-compose -f Docker/prod_mode/docker-compose.yml up",
    "stop": "make stop",
    "stop:prod": "docker-compose -f Docker/prod_mode/docker-compose.yml down",
    "test": "yarn node --expose-gc $(yarn bin jest) --maxWorkers=50%",
    "test:leaks": "yarn node --expose-gc $(yarn bin jest) --runInBand --logHeapUsage --detectLeaks",
    "test:watch": "yarn node --expose-gc $(yarn bin jest) -i --watch",
    "test:coverage": "yarn node --expose-gc $(yarn bin jest)  --maxWorkers=50% --coverage",
    "test:branch:coverage": "mkdir -p ./reports/web && yarn node --expose-gc $(yarn bin jest) --changedSince origin/master --coverage --coverageDirectory ./reports/web/ --coverageThreshold='{\"global\":{\"branches\":\"0\",\"functions\":\"0\",\"lines\":\"0\"}}'",
    "lint": "eslint ./ --quiet",
    "typecheck": "tsc -b",
    "format": "prettier --ignore-path ../../../.prettierignore --write ./**/*.{js,ts,tsx,jsx,css}",
    "size": "bundlesize",
    "perf": "node ../../../tools/bundle-size.js"
  },
